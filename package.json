{
  "name": "booking-hotel-system",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@cap-js/cds-types": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-hotels": "cds watch --open hotels/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "sapux": [
    "app/hotels"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/my-bookshop.sqlite"
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "soso@mail.com": {
              "password": "soso",
              "roles": [
                "admin"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  }
}
